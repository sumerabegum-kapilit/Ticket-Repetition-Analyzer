# Copy this file to .env and fill in your real values. .env is never committed.

# --- MongoDB (leave blank to run against the bundled sample dataset instead) ---
MONGO_URI=
MONGO_DB=
MONGO_COLLECTION=tickets

# --- Embeddings (local, free, runs on your machine) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cosine similarity above which two tickets are considered "the same issue".
# Raise it if unrelated tickets are getting merged; lower it if obvious
# duplicates are being kept separate. Tune this against real examples.
SIMILARITY_THRESHOLD=0.78

# --- Optional: LLM layer for cleaner cluster names + the Ask AI Q&A page ---
# "none" (default, free, fully offline), "anthropic", "deepseek", "gemini", or "openrouter"
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Free tier: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenRouter: one key, many models (get a key at https://openrouter.ai/keys).
# Leave OPENROUTER_MODEL blank to rotate across OPENROUTER_MODELS (comma-
# separated; defaults to a built-in free-tier pool in src/llm.py) in random
# order per request, failing over to the next model on rate-limit/
# unavailable - or set OPENROUTER_MODEL to pin a single model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://ticket-repetition-analyzer.local
OPENROUTER_APP_NAME=Ticket Repetition Analyzer
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_RETRIES=2

# Optional: override which provider handles a specific task, instead of
# all of them sharing LLM_PROVIDER above. Useful for e.g. running a
# cheap/fast provider for the two high-volume per-ticket jobs
# (classification, elaboration) while reserving a stronger model for the
# Ask AI answers a person actually reads. Leave blank to just use
# LLM_PROVIDER for that task.
LLM_PROVIDER_LABEL=
LLM_PROVIDER_RAG=
LLM_PROVIDER_CLASSIFY=
LLM_PROVIDER_ELABORATE=

# Optional, requires an LLM provider configured above (LLM_PROVIDER or
# LLM_PROVIDER_ELABORATE): before embedding, have an LLM rewrite each
# ticket's subject+description into a fuller sentence, so short/vague
# subjects give the embedding model more to compare on.
# This is ONE PAID CALL PER TICKET (unlike labeling/Q&A, which are one call
# per cluster/question) - turning it on over an existing backlog has a real
# one-time cost and takes noticeably longer. Leave false unless you've
# checked clustering accuracy still isn't good enough after tuning
# SIMILARITY_THRESHOLD and the synonym groups in src/preprocess.py.
EMBEDDING_ELABORATION=false

# Optional, requires an LLM provider configured above (LLM_PROVIDER or
# LLM_PROVIDER_CLASSIFY): before embedding, have an LLM fold each ticket's
# raw category into one of the categories already seen in the dataset (or
# propose a new one only if nothing fits) - cleans up inconsistent
# free-text category labels from the source system. Also ONE PAID CALL PER
# TICKET - same cost tradeoff as EMBEDDING_ELABORATION above.
AI_CLASSIFICATION=false

# --- Phase 5: automation ---
# While app.py is running (and MongoDB is configured above), check for new
# tickets every N seconds and refresh the dashboard automatically as soon as
# any show up. Set to 0 to disable background polling (the manual "Check for
# new tickets now" button on the upload page still works either way).
AUTO_REFRESH_INTERVAL_SECONDS=60
